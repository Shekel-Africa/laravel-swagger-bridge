{
    "name": "shekel/laravel-swagger-bridge",
    "description": "Auto-generate OpenAPI spec from Laravel Routes, FormRequests and Resources",
    "license": "MIT",
    "authors": [
        {
            "name": "Shekel Mobility",
            "email": "tech@shekelmobility.com"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "laravel/framework": "^9.0",
        "zircote/swagger-php": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "orchestra/testbench": "^7.0",
        "mockery/mockery": "^1.4",
        "symfony/http-foundation": "6.0.*",
        "symfony/console": "6.0.*",
        "symfony/process": "6.0.*",
        "symfony/yaml": "6.0.*",
        "symfony/var-dumper": "6.0.*"
    },
    "autoload": {
        "psr-4": {
            "Shekel\\SwaggerBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shekel\\SwaggerBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shekel\\SwaggerBridge\\SwaggerBridgeServiceProvider"
            ]
        }
    },
    "config": {
        "audit": {
            "ignore": [
                "PKSA-8qx3-n5y5-vvnd",
                "PKSA-w7xr-vk7n-rstm",
                "PKSA-365x-2zjk-pt47",
                "PKSA-b35n-565h-rs4q",
                "PKSA-wws7-mr54-jsny"
            ]
        }
    }
}
